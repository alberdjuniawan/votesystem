# App
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_TZ=Asia/Jakarta

# Database
DB_HOST=postgres
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=votesystem
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=jwt-secret
JWT_ACCESS_EXP_MINUTES=15
JWT_REFRESH_EXP_HOURS=168

# OTel
OTEL_SERVICE_NAME=votesystem
OTEL_EXPORTER_OTLP_ENDPOINT=alloy:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SAMPLER_RATE=1.0

# Grafana
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_GRAFANA_PASSWORD=admin
GF_RENDERER_TOKEN=votesystem-renderer-secret-2026

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=votesystem
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PUBLIC_BASE_URL=http://localhost:9000/votesystem
